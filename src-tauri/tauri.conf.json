{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OrdiFi Studio",
  "version": "1.0.0",
  "identifier": "io.ordifi.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OrdiFi Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1000,
        "minHeight": 650,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NkZGQjIzQzhENTZBMEQKUldRTmF0WElJL3R2SlozOUdIZWRQR2pBazRkcUxWSW0zZ3BsckVOaHVyZVJISmZoNXI5V1dYcysK",
      "endpoints": [
        "https://ordifi.app/dev/releases/studio/latest.json"
      ]
    }
  }
}
