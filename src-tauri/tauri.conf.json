{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "OrdiFi Studio",
    "version":  "0.1.0",
    "identifier":  "io.ordifi.studio",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "OrdiFi Studio",
                                    "width":  1440,
                                    "height":  900,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "minWidth":  1000,
                                    "minHeight":  650,
                                    "dragDropEnabled":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}
